# Application access (never commit the real password or hash)
APP_USERNAME=connie
APP_PASSWORD_HASH=scrypt$16384$8$1$<salt>$<hash>
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=remoire_session
CSRF_COOKIE_NAME=remoire_csrf
ALLOW_LEGACY_BEARER=false
TRUSTED_ORIGINS=https://your-domain.example,http://localhost:5173
ALLOWED_HOSTS=your-domain.example,localhost,127.0.0.1,testserver

# Only needed temporarily while migrating an older Bearer-token deployment.
API_SECRET_KEY=

# Independent key for device automation endpoints.
DEVICE_SECRET_KEY=

# SHA-256 hex digest of a high-entropy bearer token used only by remote MCP clients.
# Generate a token and digest without storing the raw token in shell history:
#   python -m scripts.generate_mcp_token
MCP_API_TOKEN_SHA256=
# 生产必填。逗号分隔 Fernet 密钥；第一把用于新加密，其余仅用于轮换时解密旧值。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_SECRET_ENCRYPTION_KEYS=
MODEL_SECRET_ENCRYPTION_REQUIRED=true

DATABASE_PATH=./data/remoire.db
UPLOADS_PATH=./uploads
